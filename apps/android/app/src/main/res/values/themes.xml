<resources>
    <style name="Theme.Rope" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/rope_ink</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/ic_rope_splash</item>
        <item name="windowSplashScreenIconBackgroundColor">@color/rope_ink</item>
        <item name="postSplashScreenTheme">@style/Theme.Rope.App</item>
        <item name="android:windowBackground">@color/rope_ink</item>
        <item name="android:statusBarColor">@color/rope_ink</item>
        <item name="android:navigationBarColor">@color/rope_ink</item>
    </style>

    <style name="Theme.Rope.App" parent="Theme.AppCompat.DayNight.NoActionBar">
        <item name="android:windowBackground">@color/rope_ink</item>
        <item name="android:statusBarColor">@color/rope_ink</item>
        <item name="android:navigationBarColor">@color/rope_ink</item>
    </style>
</resources>
